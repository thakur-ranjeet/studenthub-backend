# Copy this file to ".env" on the server and fill in real values. NEVER commit ".env".

# --- public address of the API (a DNS record must point to the server) ---
API_DOMAIN=api.example.com
# Origin of the frontend: scheme + host only, NO path and NO trailing slash
CORS_ALLOWED_ORIGIN=https://YOUR-GITHUB-USERNAME.github.io
# Full frontend address, used inside password-reset emails
FRONTEND_URL=https://YOUR-GITHUB-USERNAME.github.io/YOUR-REPO-NAME/

# --- secrets ---
DB_PASSWORD=change-me
# Base64 text, e.g. from: openssl rand -base64 48
JWT_SECRET=change-me
MAIL_USERNAME=yourname@gmail.com
MAIL_PASSWORD=your-16-char-google-app-password
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=
# Chatbot AI (optional): gemini or anthropic. Leave keys empty for basic mode.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
